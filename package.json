{
  "name": "searcherries-zapier",
  "version": "1.0.0",
  "description": "Zapier integration for Searcherries: AI visibility, search and AI-traffic data for your Zaps.",
  "scripts": {
    "clean": "rimraf ./dist ./build",
    "build": "npm run clean && tsc",
    "dev": "npm run build -- --watch",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "test": "vitest --run",
    "test:watch": "vitest",
    "validate": "zapier-platform validate --without-style",
    "_zapier-build": "npm run build"
  },
  "dependencies": {
    "zapier-platform-core": "19.2.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "nock": "^14.0.17",
    "rimraf": "^5.0.10",
    "typescript": "5.6.2",
    "vitest": "^2.1.2",
    "zapier-platform-cli": "^19.2.1"
  },
  "private": true,
  "exports": "./dist/index.js",
  "type": "module",
  "license": "MIT",
  "author": "Searcherries",
  "homepage": "https://searcherries.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/eduardmur/searcherries-zapier.git"
  },
  "engines": {
    "node": ">=22"
  }
}
